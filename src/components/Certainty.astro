---
/**
 * 04 — The certainty mechanism.
 *
 * A dark band. Three constants, no illustration: this is the one place in the
 * narrative where the argument is purely structural, so the page goes quiet and
 * lets the particle field carry the atmosphere. Big serif numerals hold the
 * layout the way the 85/91/6 stats do in section 02.
 */
import SectionHead from './SectionHead.astro';
import { type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const c = useTranslations(lang).certainty;
---

<section id="certainty" class="section section--dark section--tight certainty">
  <div class="shell">
    <SectionHead eyebrow={c.eyebrow} title={c.title} lede={c.lede} measure="wide" />

    <ol class="constants">
      {
        c.constants.map((item, i) => (
          <li class="constant" data-reveal style={`--beat:${i}`}>
            <span class="constant__index display" aria-hidden="true">
              {item.index}
            </span>
            <div class="constant__text">
              <h3 class="constant__title display">{item.title}</h3>
              <p class="constant__body">{item.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .constants {
    list-style: none;
    margin: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 1rem + 3vw, 3rem);
  }

  @media (min-width: 62rem) {
    .constants {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 0.5rem + 3.5vw, 4rem);
    }
  }

  .constant {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(0.9rem, 0.4rem + 1.6vw, 1.6rem);
    align-items: start;
    padding-block-start: 1.2rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-gold) 50%, transparent);
  }

  .constant__index {
    font-size: clamp(2.4rem, 1.4rem + 3.4vw, 4.4rem);
    line-height: 0.86;
    color: color-mix(in srgb, var(--color-gold) 88%, transparent);
    font-variant-numeric: lining-nums;
  }

  .constant__title {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-parchment);
  }

  .constant__body {
    margin: 0.5rem 0 0;
    font-size: var(--text-small);
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-parchment) 76%, transparent);
    text-wrap: pretty;
  }
</style>
