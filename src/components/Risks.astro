---
/**
 * 07 — Risks & mitigations.
 *
 * Four failure modes, each answered by a named artifact. The mitigation chip at
 * the foot of every card is the payload: presales point at it to say "that
 * risk has an owner and a document". Cards use the ember accent on the risk
 * title and gold on the mitigation, so the eye reads danger → remedy.
 */
import { Image } from 'astro:assets';
import SectionHead from './SectionHead.astro';
import { type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/content';

import sponsor from '../assets/images/risk-sponsor.webp';
import bottleneck from '../assets/images/risk-bottleneck.webp';
import champions from '../assets/images/risk-champions.webp';
import value from '../assets/images/risk-value.webp';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = useTranslations(lang).risks;

const art: Record<string, ImageMetadata> = { sponsor, bottleneck, champions, value };
---

<section id="risks" class="section risks">
  <div class="shell">
    <SectionHead eyebrow={r.eyebrow} title={r.title} lede={r.lede} measure="wide" />

    <ul class="risks__grid">
      {
        r.items.map((item, i) => (
          <li class="card risk" data-reveal style={`--beat:${i}`}>
            <figure class="risk__figure">
              <Image
                src={art[item.key]}
                alt={item.imageAlt}
                widths={[240, 400, 560]}
                sizes="(min-width: 62rem) 13rem, 32vw"
                format="webp"
                quality={78}
                loading="lazy"
              />
            </figure>
            <div class="risk__body">
              <h3 class="risk__title display">{item.title}</h3>
              <p class="risk__mitigation">
                <span class="risk__mitigation-label">{r.mitigationLabel}</span>
                {item.mitigation}
              </p>
              <p class="risk__chip">
                <span class="risk__chip-label">{r.mitigatedByLabel}</span>
                <span class="risk__chip-value">{item.mitigatedBy}</span>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .risks__grid {
    list-style: none;
    margin: clamp(2.5rem, 1.5rem + 4vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(1.25rem, 0.6rem + 2vw, 2.25rem);
  }

  @media (min-width: 56rem) {
    .risks__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .risk {
    flex-direction: row;
    overflow: hidden;
  }

  .risk__figure {
    margin: 0;
    flex: 0 0 clamp(6.5rem, 4rem + 12vw, 12rem);
    overflow: hidden;
  }

  .risk__figure :global(img) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .risk__body {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.1rem, 0.7rem + 1.4vw, 1.9rem);
    /* Pin the chip to the foot so all four cards align on it. */
    grid-template-rows: auto 1fr auto;
  }

  .risk__title {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-ink);
    text-wrap: balance;
  }

  .risk__mitigation {
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
    text-wrap: pretty;
  }

  .risk__mitigation-label {
    display: block;
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-ember);
    margin-block-end: 0.25rem;
  }

  .risk__chip {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin: 0.4rem 0 0;
    padding-block-start: 0.85rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
  }

  .risk__chip-label {
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .risk__chip-value {
    font-family: var(--font-display);
    font-size: var(--text-small);
    color: var(--color-gold);
  }

  @media (max-width: 34rem) {
    .risk {
      flex-direction: column;
    }

    .risk__figure {
      flex: none;
      block-size: 9rem;
    }
  }
</style>
