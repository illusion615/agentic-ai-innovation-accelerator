---
import { Image } from 'astro:assets';
import heroImage from '../assets/images/hero-workshop.webp';
import { type Lang } from '../i18n/config';
import { useTranslations } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="hero" class="hero">
  <div class="hero__art">
    <Image
      src={heroImage}
      alt={t.hero.imageAlt}
      widths={[640, 960, 1280, 1600, 2048]}
      sizes="(min-width: 64rem) 46vw, 100vw"
      format="webp"
      quality={82}
      loading="eager"
      fetchpriority="high"
      class="hero__img"
    />
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__panel">
    <div class="hero__content">
      <div class="hero__eyebrow" data-reveal>
        <p class="eyebrow">{t.hero.eyebrow}</p>
        <p class="hero__eyebrow-sub">{t.hero.eyebrowSub}</p>
      </div>

      <h1 class="hero__title display" data-reveal style="--beat:1">
        <span class="hero__title-top">{t.hero.titleTop}</span>
        <span class="hero__title-bottom">{t.hero.titleBottom}</span>
      </h1>

      <hr class="rule-gold hero__rule" data-reveal style="--beat:2" />

      <p class="hero__lede" data-reveal style="--beat:3">{t.hero.lede}</p>

      <a class="hero__scroll" href="#challenge" data-reveal style="--beat:4">
        <span>{t.hero.scrollHint}</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-block-size: 100svh;
    display: grid;
    background: var(--color-ink-deep);
    color: var(--color-parchment);
    isolation: isolate;
    overflow: hidden;
    /* The opening runs slower than the rest of the page. It is the one scene
       nobody has scrolled to — it plays while the room is still settling — so
       it can afford the extra half second the body sections cannot. */
    --beat-step: 145ms;
    --beat-dur: 1250ms;
  }

  /* Mobile: the illustration is a full-bleed backdrop under a heavy scrim. */
  .hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* The image is over-scaled to give the drift room to move; without this the
       surplus spills past the column and lands beside the scrim, not under it. */
    overflow: hidden;
  }

  .hero__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: 62% 45%;
    /* Unlike the section artwork this layer scrolls away with its section, so
       the drift runs *with* the page but slower than it — the ordinary depth
       cue. Scaled up by the amount the drift needs to move within. */
    transform: translate3d(0, calc((var(--scene-p, 0.5) - 0.5) * 3.5rem), 0) scale(1.07);
    will-change: transform;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        var(--color-ink-deep) 0%,
        color-mix(in srgb, var(--color-ink-deep) 82%, transparent) 46%,
        color-mix(in srgb, var(--color-ink-deep) 55%, transparent) 100%
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-ink-deep) 78%, transparent),
        color-mix(in srgb, var(--color-ink-deep) 35%, transparent) 45%,
        color-mix(in srgb, var(--color-ink-deep) 72%, transparent)
      );
  }

  .hero__panel {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: center;
    padding-block: clamp(7rem, 5rem + 8vw, 12rem) clamp(3rem, 2rem + 4vw, 6rem);
    padding-inline: max(var(--spacing-gutter), calc((100vw - 108rem) / 2));
  }

  .hero__content {
    inline-size: 100%;
    /* The title is sized against the panel, not the viewport, so the split
       layout can never push "Innovation Accelerator" past the panel edge. */
    container-type: inline-size;
  }

  .hero__eyebrow-sub {
    margin: 0.6rem 0 0;
    font-size: var(--text-small);
    letter-spacing: 0.05em;
    color: color-mix(in srgb, var(--color-parchment) 78%, transparent);
  }

  .hero__title {
    margin: clamp(2rem, 1rem + 3vw, 3.5rem) 0 0;
    font-size: clamp(2.75rem, 10.6cqi, 7rem);
    display: grid;
  }

  .hero__title-top {
    color: var(--color-parchment);
  }

  .hero__title-bottom {
    color: var(--color-gold);
  }

  .hero__rule {
    margin-block: clamp(1.6rem, 1rem + 1.6vw, 2.6rem);
  }

  .hero__lede {
    margin: 0;
    max-inline-size: 34ch;
    font-size: var(--text-lede);
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-parchment) 92%, transparent);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-block-start: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    color: color-mix(in srgb, var(--color-parchment) 72%, transparent);
    text-decoration: none;
    font-size: var(--text-micro);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    transition: color var(--duration-quick) ease;
  }

  .hero__scroll:hover {
    color: var(--color-gold);
  }

  .hero__scroll-line {
    inline-size: clamp(3rem, 6vw, 6rem);
    block-size: 1px;
    background: currentColor;
    position: relative;
    overflow: hidden;
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inline-size: 40%;
    background: var(--color-gold);
    animation: hero-trace 2.4s var(--ease-in-out-soft) infinite;
  }

  @keyframes hero-trace {
    0% {
      transform: translateX(-110%);
    }
    60%,
    100% {
      transform: translateX(260%);
    }
  }

  @media (min-width: 64rem) {
    /* Desktop: the deck's split — solid navy panel beside a clean, bright
       illustration. No heavy scrim, so the dawn light survives the projector. */
    .hero {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    }

    .hero__art {
      position: relative;
      inset: auto;
      grid-column: 2;
      grid-row: 1;
    }

    .hero__img {
      object-position: center;
    }

    .hero__scrim {
      /* Eased rather than linear: the panel holds its own colour for a beat,
         then lets go slowly, so the seam between navy and dawn light never
         resolves into an edge. */
      background: linear-gradient(
        to right,
        var(--color-ink-deep) 0%,
        var(--color-ink-deep) 2%,
        color-mix(in srgb, var(--color-ink-deep) 86%, transparent) 6%,
        color-mix(in srgb, var(--color-ink-deep) 52%, transparent) 11%,
        color-mix(in srgb, var(--color-ink-deep) 22%, transparent) 16%,
        transparent 22%
      );
    }

    .hero__panel {
      padding-inline-end: clamp(2rem, 3vw, 4rem);
    }

    .hero__lede {
      max-inline-size: 32ch;
    }
  }
</style>
