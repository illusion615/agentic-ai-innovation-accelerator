---
/**
 * THE PORTAL — what you see when you open the tool.
 *
 * The first question on arriving is "which customer am I here for", not "what
 * is step one". So the entry is a shelf of engagements, and the three-step
 * console lives one click in, scoped to whichever project you opened. Keeping
 * the two apart is what stops the console from asking you to pick a project
 * and start work in the same breath.
 *
 * Stage and progress are read off each session's own evidence rather than
 * stored, so a card cannot claim progress the project has not made.
 */
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/SectionHead.astro';
import { LANGS, isLang, localePath, type Lang } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang: raw } = Astro.params;
const lang: Lang = isLang(raw) ? raw : 'en';
const t = useTranslations(lang);
const po = t.program.portal;

const bootstrap = {
  strings: po,
  // The five stages are named once, in the story data; the cards join to it.
  stages: Object.fromEntries(
    t.journey.stages.map((s) => [s.id, { index: s.index, name: s.name }])
  ),
  projectHref: localePath(lang, '/program/project/'),
};
---

<Base lang={lang} path="/program/" axis={false} title={po.title}>
  <section id="portal" class="section portal">
    <div class="shell">
      <SectionHead as="h1" eyebrow={po.eyebrow} title={po.title} lede={po.lede} measure="wide" />

      <div class="portal__bar">
        <button type="button" class="btn btn--gold" data-new-project>{po.newCta}</button>
        <p class="portal__note">{po.note}</p>
      </div>

      <div class="portal__empty" data-empty hidden>
        <h2 class="portal__empty-title display">{po.emptyTitle}</h2>
        <p class="portal__empty-body">{po.emptyBody}</p>
      </div>

      <ul class="cards" data-cards></ul>
    </div>
  </section>

  <dialog class="newproj" data-dialog aria-labelledby="newproj-title">
    <form method="dialog" class="newproj__form">
      <h2 class="newproj__title display" id="newproj-title">{po.dialogTitle}</h2>
      <p class="newproj__lede">{po.dialogLede}</p>

      <label class="newproj__label meta-label" for="newproj-name">{po.nameLabel}</label>
      <input
        id="newproj-name"
        class="newproj__input"
        type="text"
        required
        autocomplete="off"
        placeholder={po.namePlaceholder}
        data-new-name
      />

      <label class="newproj__label meta-label" for="newproj-facilitator">
        {po.facilitatorLabel}
      </label>
      <input
        id="newproj-facilitator"
        class="newproj__input"
        type="text"
        autocomplete="off"
        placeholder={po.facilitatorPlaceholder}
        data-new-facilitator
      />

      <menu class="newproj__actions">
        <button type="submit" class="btn btn--quiet" value="cancel" formnovalidate>
          {po.cancelCta}
        </button>
        <button type="submit" class="btn btn--gold" value="create">{po.createCta}</button>
      </menu>
    </form>
  </dialog>

  <script type="application/json" data-portal-bootstrap set:html={JSON.stringify(bootstrap)} />
</Base>

<script>
  import {
    LocalSessionStore,
    createSession,
    setActiveSessionId,
    projectProgress,
  } from '../../../lib/session';

  const boot = document.querySelector('[data-portal-bootstrap]');

  if (boot) {
    const cfg = JSON.parse(boot.textContent ?? '{}');
    const s = cfg.strings;
    const store = new LocalSessionStore();

    const cards = document.querySelector<HTMLElement>('[data-cards]')!;
    const empty = document.querySelector<HTMLElement>('[data-empty]')!;
    const dialog = document.querySelector<HTMLDialogElement>('[data-dialog]')!;

    const dateFmt = new Intl.DateTimeFormat(document.documentElement.lang, { dateStyle: 'medium' });

    function open(id: string) {
      setActiveSessionId(id);
      location.href = cfg.projectHref;
    }

    async function render() {
      const metas = await store.list();
      cards.textContent = '';
      empty.hidden = metas.length > 0;

      for (const meta of metas) {
        const session = await store.load(meta.id);
        if (!session) continue;

        const progress = projectProgress(session);
        const stage = progress.stage ? cfg.stages[progress.stage] : null;
        const name = session.customer.trim() || s.untitled;

        const li = document.createElement('li');
        li.className = 'card';

        const stageRow = document.createElement('p');
        stageRow.className = 'card__stage meta-label';
        if (stage) {
          const idx = document.createElement('span');
          idx.className = 'card__stage-index';
          idx.textContent = stage.index;
          stageRow.append(idx, document.createTextNode(stage.name));
        } else {
          stageRow.classList.add('card__stage--none');
          stageRow.textContent = s.stageNotStarted;
        }

        const heading = document.createElement('h2');
        heading.className = 'card__name display';
        heading.textContent = name;

        const meta2 = document.createElement('dl');
        meta2.className = 'card__meta';
        (
          [
            [s.startedLabel, dateFmt.format(new Date(session.createdAt))],
            [s.progressLabel, `${progress.percent}%`],
          ] as const
        ).forEach(([term, value]) => {
          const wrap = document.createElement('div');
          const dt = document.createElement('dt');
          dt.textContent = term;
          const dd = document.createElement('dd');
          dd.textContent = value;
          wrap.append(dt, dd);
          meta2.append(wrap);
        });

        const bar = document.createElement('div');
        bar.className = 'card__bar';
        bar.setAttribute('role', 'progressbar');
        bar.setAttribute('aria-valuenow', String(progress.percent));
        bar.setAttribute('aria-valuemin', '0');
        bar.setAttribute('aria-valuemax', '100');
        bar.setAttribute('aria-label', s.progressLabel);
        const fill = document.createElement('span');
        fill.style.width = `${progress.percent}%`;
        bar.append(fill);

        const actions = document.createElement('div');
        actions.className = 'card__actions';

        const openBtn = document.createElement('button');
        openBtn.type = 'button';
        openBtn.className = 'btn btn--quiet';
        openBtn.textContent = s.openCta;
        openBtn.addEventListener('click', () => open(session.id));

        const del = document.createElement('button');
        del.type = 'button';
        del.className = 'card__delete';
        del.textContent = s.deleteLabel;
        del.addEventListener('click', async (event) => {
          event.stopPropagation();
          if (!confirm(s.deleteConfirm.replace('{name}', name))) return;
          await store.remove(session.id);
          await render();
        });

        actions.append(openBtn, del);
        li.append(stageRow, heading, meta2, bar, actions);

        // The whole card is the target; the button is there for keyboard and
        // for people who expect one.
        li.addEventListener('click', (event) => {
          if ((event.target as HTMLElement).closest('button')) return;
          open(session.id);
        });

        cards.append(li);
      }
    }

    void render();

    document.querySelector('[data-new-project]')?.addEventListener('click', () => {
      dialog.querySelector<HTMLInputElement>('[data-new-name]')!.value = '';
      dialog.querySelector<HTMLInputElement>('[data-new-facilitator]')!.value = '';
      dialog.showModal();
    });

    dialog.addEventListener('close', async () => {
      if (dialog.returnValue !== 'create') return;
      const name = dialog.querySelector<HTMLInputElement>('[data-new-name]')!.value.trim();
      const facilitator = dialog
        .querySelector<HTMLInputElement>('[data-new-facilitator]')!
        .value.trim();
      if (!name) return;

      const fresh = createSession({ customer: name, facilitator });
      await store.save(fresh);
      open(fresh.id);
    });
  }
</script>

<style>
  .portal__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-block-start: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .portal__note {
    margin: 0;
    font-size: var(--text-micro);
    color: var(--color-muted);
  }

  .portal__empty {
    margin-block-start: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border: 1px dashed color-mix(in srgb, var(--color-ink) 22%, transparent);
    text-align: center;
  }

  .portal__empty[hidden] {
    display: none;
  }

  .portal__empty-title {
    margin: 0 0 0.4rem;
    font-size: var(--text-h3);
  }

  .portal__empty-body {
    margin: 0;
    color: var(--color-muted);
  }

  .cards {
    list-style: none;
    margin: clamp(1.5rem, 1rem + 2vw, 2.5rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: clamp(0.9rem, 0.7rem + 1vw, 1.5rem);
  }

  :global(.card) {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: clamp(1rem, 0.85rem + 0.8vw, 1.4rem);
    border: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    background: color-mix(in srgb, var(--color-parchment-deep) 40%, transparent);
    cursor: pointer;
    transition:
      border-color var(--duration-base) var(--ease-in-out-soft),
      transform var(--duration-base) var(--ease-in-out-soft);
  }

  :global(.card:hover) {
    border-color: var(--color-gold);
    transform: translateY(-2px);
  }

  :global(.card__stage) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--color-ink);
  }

  :global(.card__stage--none) {
    color: var(--color-muted);
  }

  :global(.card__stage-index) {
    display: inline-grid;
    place-items: center;
    min-width: 1.6rem;
    height: 1.6rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-gold) 35%, transparent);
  }

  :global(.card__name) {
    margin: 0;
    font-size: var(--text-h3);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  :global(.card__meta) {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  :global(.card__meta dt) {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }

  :global(.card__meta dd) {
    margin: 0.1rem 0 0;
    font-size: var(--text-small);
    color: var(--color-ink);
  }

  :global(.card__bar) {
    height: 3px;
    background: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  :global(.card__bar span) {
    display: block;
    height: 100%;
    background: var(--color-gold);
  }

  :global(.card__actions) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: 0.15rem;
  }

  :global(.card__delete) {
    background: none;
    border: 0;
    cursor: pointer;
    font-size: var(--text-micro);
    color: var(--color-muted);
    text-decoration: underline;
  }

  :global(.card__delete:hover),
  :global(.card__delete:focus-visible) {
    color: var(--color-ember);
  }

  /* --- New project dialog ---------------------------------------------- */
  .newproj {
    margin: auto;
    border: 1px solid color-mix(in srgb, var(--color-ink) 20%, transparent);
    background: var(--color-parchment);
    color: var(--color-ink);
    padding: 0;
    width: min(30rem, calc(100vw - 2rem));
  }

  .newproj::backdrop {
    background: color-mix(in srgb, var(--color-ink-deep) 55%, transparent);
    backdrop-filter: blur(3px);
  }

  .newproj__form {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }

  .newproj__title {
    margin: 0;
    font-size: var(--text-h3);
  }

  .newproj__lede {
    margin: 0 0 0.5rem;
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .newproj__label {
    margin-block-start: 0.4rem;
  }

  .newproj__input {
    font: inherit;
    color: var(--color-ink);
    background: transparent;
    border: 0;
    border-block-end: 2px solid color-mix(in srgb, var(--color-gold) 55%, transparent);
    padding: 0.35rem 0;
  }

  .newproj__input:focus-visible {
    outline: none;
    border-block-end-color: var(--color-gold);
  }

  .newproj__actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.6rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }
</style>
