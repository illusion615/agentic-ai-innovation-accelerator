---
/**
 * STAGE 04 — the lab path, composed rather than authored.
 *
 * The accelerator's deliverable is not somebody's expense bot. It is the answer
 * to "given what you want to do, which tools do your people need to be able to
 * reach for" — generalising from the particular scenarios they brought. So a
 * scenario carries capability tags, a lab module teaches exactly one
 * capability, and a customer's path is the union of the tags across everything
 * they collected, closed over prerequisites and sorted into an order that can
 * actually be walked.
 *
 * Two things this buys, and both are the reason it is worth the indirection:
 * a module is written once and serves every scenario that needs it, rather
 * than a bespoke lab per customer; and a colleague who has never opened the
 * tool gets a path that is demonstrably about their own work rather than a
 * generic course they have to translate.
 *
 * With nothing collected the shelf is still shown in full — it is useful on its
 * own to someone who just wants to know what there is to learn — but the
 * composed path is the output that matters.
 */
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import SectionHead from '../../../../components/SectionHead.astro';
import { LANGS, isLang, localePath, type Lang } from '../../../../i18n/config';
import { useTranslations } from '../../../../i18n/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang: raw } = Astro.params;
const lang: Lang = isLang(raw) ? raw : 'en';
const t = useTranslations(lang);
const l = t.labs;

const modules = (await getCollection('labs')).sort((a, b) => a.data.order - b.data.order);
const examples = await getCollection('scenarios');

const bootstrap = {
  capabilities: t.capabilities,
  // Enough to close over prerequisites and order the result client-side.
  modules: modules.map((m) => ({ id: m.id, requires: m.data.requires, order: m.data.order, minutes: m.data.minutes })),
  // Taken scenarios are titled from here so the path reads in this edition.
  exampleTitles: Object.fromEntries(examples.map((e) => [e.id, e.data[lang].title])),
  // Base- and locale-prefixed on the server; the client only substitutes the id.
  guideHref: localePath(lang, '/program/labs/{id}/'),
  strings: {
    composedTitle: l.composedTitle,
    composedNote: l.composedNote,
    buildOrderTitle: l.buildOrderTitle,
    buildOrderNote: l.buildOrderNote,
    restNote: l.restNote,
    restNone: l.restNone,
    fromLabel: l.fromLabel,
    prereqNote: l.prereqNote,
    minutesLabel: l.minutesLabel,
    duration: t.present.duration,
    buildStepLabel: l.buildStepLabel,
    agendaTitle: l.agendaTitle,
    agendaNote: l.agendaNote,
    sessionTitle: l.sessionTitle,
    manualReason: l.libraryManualReason,
  },
  departments: t.intake.departments,
};
---

<Base lang={lang} path="/program/labs/" axis={false} title={l.title}>
  <section id="labs" class="section labs">
    <div class="shell">
      <SectionHead as="h1" eyebrow={l.eyebrow} title={l.title} lede={l.lede} measure="wide" />

      <div class="labs__empty" data-empty hidden>
        <h2 class="labs__empty-title display">{l.emptyTitle}</h2>
        <p class="labs__empty-body">{l.emptyBody}</p>
        <a class="btn btn--gold" href={localePath(lang, '/program/scenarios/')}>{l.emptyCta}</a>
      </div>

      <!-- How big this engagement is, before any list. -->
      <dl class="tally" data-tally hidden>
        <div>
          <dt>{l.tally.modules}</dt>
          <dd data-tally-modules></dd>
        </div>
        <div>
          <dt>{l.tally.time}</dt>
          <dd data-tally-time></dd>
        </div>
        <div>
          <dt>{l.tally.sittings}</dt>
          <dd data-tally-sittings></dd>
        </div>
      </dl>

      <!--
        One answer, not three. Before stage 03 has ranked anything this is the
        whole implied path; once it has, it narrows to what to build first.
        Showing both as peers is what made this page unreadable.
      -->
      <section class="answer" data-answer hidden>
        <h2 class="answer__title display" data-answer-title></h2>
        <p class="answer__note" data-answer-note></p>

        <ol class="order__list" data-order-list hidden></ol>
        <ol class="composed__list" data-path hidden></ol>

        <section class="agenda" data-agenda hidden>
          <h2 class="agenda__title display">{l.agendaTitle}</h2>
          <p class="agenda__note">{l.agendaNote}</p>
          <ol class="agenda__sessions" data-agenda-sessions></ol>
        </section>

        <p class="answer__rest" data-rest hidden></p>

        <div class="order__prompt" data-order-prompt hidden>
          <p class="order__prompt-note">{l.buildNoScoreNote}</p>
          <a class="btn btn--quiet" href={localePath(lang, '/program/prioritize/')}>
            {l.buildNoScoreCta}
          </a>
        </div>

        <p class="answer__foot" data-answer-foot hidden>{l.notYetNote}</p>
      </section>

      <aside class="library-callout">
        <div>
          <p class="library-callout__eyebrow meta-label">{l.libraryTitle}</p>
          <p class="library-callout__note">{l.shelfNote}</p>
        </div>
        <a class="btn btn--quiet" href={localePath(lang, '/program/labs/library/')}>{l.libraryOpen}</a>
      </aside>

      <!-- The unranked path clones these cards; the visible collection lives in the Library. -->
      <ul data-module-templates hidden>
          {
            modules.map((mod) => {
              const copy = mod.data[lang];
              return (
                <li class="mod" data-module={mod.id}>
                  <p class="mod__meta meta-label">
                    {t.capabilities[mod.id]} · {mod.data.minutes} {l.minutesLabel}
                  </p>
                  <h3 class="mod__name">
                    <a class="mod__link" href={localePath(lang, `/program/labs/${mod.id}/`)}>{copy.name}</a>
                  </h3>

                  <p class="mod__line">
                    <span class="mod__label">{l.teachesLabel}</span>
                    <span>{copy.teaches}</span>
                  </p>
                  <p class="mod__line">
                    <span class="mod__label mod__label--out">{l.buildLabel}</span>
                    <span>{copy.build}</span>
                  </p>

                  {mod.data.requires.length > 0 && (
                    <p class="mod__req">
                      {l.afterLabel}:{' '}
                      {mod.data.requires.map((r) => t.capabilities[r]).join(' · ')}
                    </p>
                  )}
                </li>
              );
            })
          }
      </ul>

      <div class="labs__foot">
        <a class="btn btn--quiet" href={localePath(lang, '/program/scenarios/')}>{l.emptyCta}</a>
        <a class="btn btn--gold" href={localePath(lang, '/program/project/')}>{l.backLabel}</a>
      </div>
    </div>
  </section>

  <script type="application/json" data-labs-bootstrap set:html={JSON.stringify(bootstrap)} />
</Base>

<script>
  import { LocalSessionStore, openActiveSession } from '../../../../lib/session';
  import { formatDuration, packSessions } from '../../../../lib/duration';
  import { resolveLabPath } from '../../../../lib/lab-path';

  const boot = document.querySelector('[data-labs-bootstrap]');

  if (boot) {
    const cfg = JSON.parse(boot.textContent ?? '{}');
    const store = new LocalSessionStore();
    const session = await openActiveSession(store);

    interface Mod {
      id: string;
      requires: string[];
      order: number;
      minutes: number;
    }
    // Which collected scenarios asked for each capability — the reason a module
    // is in the path is as useful as the module.
    const askedBy = new Map<string, string[]>();
    for (const scenario of session.scenarios) {
      const title = scenario.sourceId
        ? (cfg.exampleTitles[scenario.sourceId] ?? scenario.title)
        : scenario.title;
      for (const cap of scenario.capabilities ?? []) {
        askedBy.set(cap, [...(askedBy.get(cap) ?? []), title]);
      }
    }

    const manualLabs = new Set(session.manualLabs ?? []);
    const allPath = resolveLabPath<Mod>(cfg.modules, [...askedBy.keys(), ...manualLabs]);

    const emptyBox = document.querySelector<HTMLElement>('[data-empty]')!;
    const answer = document.querySelector<HTMLElement>('[data-answer]')!;
    const tally = document.querySelector<HTMLElement>('[data-tally]')!;

    const top = session.scoring.length
      ? session.top3
          .map((id) => session.scenarios.find((s) => s.id === id))
          .filter((s): s is NonNullable<typeof s> => !!s)
      : [];

    if (!allPath.length) {
      emptyBox.hidden = false;
    } else {
      tally.hidden = false;
      answer.hidden = false;

      const title = document.querySelector<HTMLElement>('[data-answer-title]')!;
      const note = document.querySelector<HTMLElement>('[data-answer-note]')!;

      if (top.length) {
        const agendaAskedBy = requestsFor(top);
        const agendaPath = resolveLabPath<Mod>(cfg.modules, [...agendaAskedBy.keys(), ...manualLabs]);
        renderTally(agendaPath);
        title.textContent = cfg.strings.buildOrderTitle;
        note.textContent = cfg.strings.buildOrderNote;
        renderBuildOrder(top);
        renderAgenda(agendaPath, agendaAskedBy, manualLabs);
        renderRest(top, allPath);
        document.querySelector<HTMLElement>('[data-answer-foot]')!.hidden = false;
      } else {
        renderTally(allPath);
        title.textContent = cfg.strings.composedTitle;
        note.textContent = cfg.strings.composedNote;
        renderPath(allPath);
        document.querySelector<HTMLElement>('[data-order-prompt]')!.hidden = false;
      }
    }

    function requestsFor(scenarios: typeof top) {
      const requests = new Map<string, string[]>();
      for (const scenario of scenarios) {
        const title = scenario.sourceId
          ? (cfg.exampleTitles[scenario.sourceId] ?? scenario.title)
          : scenario.title;
        for (const capability of scenario.capabilities ?? []) {
          requests.set(capability, [...(requests.get(capability) ?? []), title]);
        }
      }
      return requests;
    }

    /** Size of the engagement, in the same sittings the room deck will use. */
    function renderTally(path: Mod[]) {
      const minutes = path.reduce((sum, m) => sum + m.minutes, 0);
      document.querySelector<HTMLElement>('[data-tally-modules]')!.textContent = String(path.length);
      document.querySelector<HTMLElement>('[data-tally-time]')!.textContent = formatDuration(
        minutes,
        cfg.strings.duration
      );
      document.querySelector<HTMLElement>('[data-tally-sittings]')!.textContent = String(
        packSessions(path).length
      );
    }

    /**
     * What the unranked remainder of the backlog adds beyond the Top 3. Named
     * in a sentence rather than shown as a second full list, which is all the
     * old "composed path" section was actually contributing once ranked.
     */
    function renderRest(top: { capabilities?: string[] }[], path: Mod[]) {
      const covered = new Set(
        resolveLabPath<Mod>(
          cfg.modules,
          [...top.flatMap((s) => s.capabilities ?? []), ...manualLabs]
        ).map((m) => m.id)
      );
      const rest = path.filter((m) => !covered.has(m.id));
      const el = document.querySelector<HTMLElement>('[data-rest]')!;
      el.textContent = rest.length
        ? cfg.strings.restNote.replace(
            '{modules}',
            rest.map((m) => cfg.capabilities[m.id] ?? m.id).join(' · ')
          )
        : cfg.strings.restNone;
      el.hidden = false;
    }

    /**
     * Stage 03's Top 3, each with the modules that *particular* build needs —
     * the question a team asks on the morning they start.
     */
    function renderBuildOrder(top: NonNullable<(typeof session.scenarios)[number]>[]) {
      const list = document.querySelector<HTMLElement>('[data-order-list]')!;
      list.hidden = false;
      list.textContent = '';

      top.forEach((scenario, index) => {
        const modules = resolveLabPath<Mod>(cfg.modules, scenario.capabilities ?? []);
        const minutes = modules.reduce((sum, m) => sum + m.minutes, 0);

        const li = document.createElement('li');
        li.className = 'build';

        const head = document.createElement('div');
        head.className = 'build__head';

        const rank = document.createElement('p');
        rank.className = 'build__rank display';
        rank.textContent = String(index + 1);

        const heading = document.createElement('div');
        const meta = document.createElement('p');
        meta.className = 'build__meta meta-label';
        const dept = scenario.department ? cfg.departments[scenario.department] : '';
        meta.textContent = [cfg.strings.buildStepLabel, dept].filter(Boolean).join(' · ');
        const name = document.createElement('h3');
        name.className = 'build__name';
        name.textContent = scenario.sourceId
          ? (cfg.exampleTitles[scenario.sourceId] ?? scenario.title)
          : scenario.title;
        heading.append(meta, name);

        const time = document.createElement('p');
        time.className = 'build__time';
        time.textContent = formatDuration(minutes, cfg.strings.duration);

        head.append(rank, heading, time);
        li.append(head);

        const steps = document.createElement('ol');
        steps.className = 'build__steps';
        for (const mod of modules) {
          const step = document.createElement('li');
          step.className = 'build__step';
          const link = document.createElement('a');
          link.className = 'mod__link mod__link--step';
          link.href = cfg.guideHref.replace('{id}', mod.id);
          link.textContent = cfg.capabilities[mod.id] ?? mod.id;
          step.append(link);
          steps.append(step);
        }
        li.append(steps);
        list.append(li);
      });
    }

    function renderAgenda(
      path: Mod[],
      requestedBy: Map<string, string[]>,
      manuallySelected: Set<string>
    ) {
      const agenda = document.querySelector<HTMLElement>('[data-agenda]')!;
      const list = document.querySelector<HTMLOListElement>('[data-agenda-sessions]')!;
      const sessions = packSessions(path);
      list.textContent = '';

      sessions.forEach((group, sessionIndex) => {
        const sitting = document.createElement('li');
        sitting.className = 'agenda__session';

        const head = document.createElement('div');
        head.className = 'agenda__head';
        const heading = document.createElement('h3');
        heading.className = 'agenda__session-title display';
        heading.textContent = cfg.strings.sessionTitle
          .replace('{n}', String(sessionIndex + 1))
          .replace('{total}', String(sessions.length));
        const duration = document.createElement('p');
        duration.className = 'agenda__duration';
        duration.textContent = formatDuration(
          group.reduce((sum, module) => sum + module.minutes, 0),
          cfg.strings.duration
        );
        head.append(heading, duration);

        const modules = document.createElement('ol');
        modules.className = 'agenda__modules';
        group.forEach((module) => {
          const item = document.createElement('li');
          item.className = 'agenda__module';
          const link = document.createElement('a');
          link.className = 'mod__link agenda__module-link';
          link.href = cfg.guideHref.replace('{id}', module.id);
          link.textContent = cfg.capabilities[module.id] ?? module.id;
          const reason = document.createElement('span');
          reason.className = 'agenda__reason';
          const scenarios = requestedBy.get(module.id);
          reason.textContent = scenarios?.length
            ? `${cfg.strings.fromLabel}: ${[...new Set(scenarios)].join(' · ')}`
            : manuallySelected.has(module.id)
              ? cfg.strings.manualReason
            : cfg.strings.prereqNote;
          item.append(link, reason);
          modules.append(item);
        });

        sitting.append(head, modules);
        list.append(sitting);
      });

      agenda.hidden = false;
    }

    function renderPath(path: Mod[]) {
      const list = document.querySelector<HTMLElement>('[data-path]')!;
      list.hidden = false;
      list.textContent = '';

      for (const mod of path) {
        // The shelf already renders every module; clone rather than rebuild so
        // the two can never describe the same module differently.
        const source = document.querySelector<HTMLElement>(`[data-module="${mod.id}"]`)!;
        const li = source.cloneNode(true) as HTMLElement;
        li.removeAttribute('data-module');
        li.classList.add('mod--in-path');

        const why = document.createElement('p');
        why.className = 'mod__why';
        const asked = askedBy.get(mod.id);
        why.textContent = asked?.length
          ? `${cfg.strings.fromLabel}: ${[...new Set(asked)].join(' · ')}`
          : cfg.strings.prereqNote;
        if (!asked?.length) why.classList.add('mod__why--prereq');
        li.append(why);

        list.append(li);
      }
    }
  }
</script>

<style>
  .labs__empty {
    margin-block-start: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    padding: clamp(1.3rem, 1rem + 1.4vw, 2rem);
    background: color-mix(in srgb, var(--color-parchment-deep) 55%, transparent);
    border-inline-start: 4px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
    max-inline-size: 56rem;
  }

  .labs__empty-title {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-ink);
  }

  .labs__empty-body {
    margin: 0.5rem 0 1.1rem;
    max-inline-size: 58ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }

  /* --- How big this engagement is -------------------------------------- */
  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem clamp(2rem, 1.4rem + 3vw, 4rem);
    margin: clamp(1.75rem, 1.2rem + 2vw, 2.75rem) 0 0;
    padding-block-end: clamp(1rem, 0.8rem + 0.9vw, 1.4rem);
    border-block-end: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
    max-inline-size: 62rem;
  }

  .tally dt {
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .tally dd {
    margin: 0.15rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem);
    line-height: 1.1;
    color: var(--color-gold);
  }

  /* --- One answer, whichever state the project is in -------------------- */
  .answer {
    margin-block-start: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    max-inline-size: 62rem;
  }

  .answer__title {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-ink);
  }

  .answer__note {
    margin: 0.45rem 0 0;
    max-inline-size: 62ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .answer__rest {
    margin: clamp(1.2rem, 0.9rem + 1.2vw, 1.8rem) 0 0;
    padding: clamp(0.8rem, 0.7rem + 0.5vw, 1.1rem) clamp(1rem, 0.8rem + 0.9vw, 1.4rem);
    border-inline-start: 3px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
    background: color-mix(in srgb, var(--color-parchment-deep) 45%, transparent);
    max-inline-size: 62ch;
    font-size: var(--text-small);
    line-height: 1.7;
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }

  .answer__foot {
    margin: 1.2rem 0 0;
    max-inline-size: 62ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .order__list {
    list-style: none;
    margin: clamp(1.2rem, 0.9rem + 1.2vw, 1.8rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(0.9rem, 0.7rem + 0.8vw, 1.3rem);
  }

  .order__prompt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
    margin-block-start: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    padding: clamp(1rem, 0.8rem + 0.9vw, 1.4rem);
    border-inline-start: 3px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
    background: color-mix(in srgb, var(--color-parchment-deep) 45%, transparent);
    max-inline-size: 62rem;
  }

  .order__prompt-note {
    flex: 1 1 26ch;
    margin: 0;
    font-size: var(--text-small);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 80%, transparent);
  }

  .order__list :global(.build) {
    padding: clamp(1rem, 0.8rem + 0.9vw, 1.4rem);
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-inline-start: 3px solid var(--color-gold);
  }

  .order__list :global(.build__head) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: 0.4rem clamp(0.8rem, 0.6rem + 0.8vw, 1.2rem);
  }

  .order__list :global(.build__rank) {
    margin: 0;
    font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem);
    line-height: 0.9;
    color: var(--color-gold);
  }

  .order__list :global(.build__meta) {
    margin: 0;
  }

  .order__list :global(.build__name) {
    margin: 0.2rem 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lede);
    line-height: 1.25;
    color: var(--color-ink);
  }

  .order__list :global(.build__time) {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lede);
    color: var(--color-gold);
    white-space: nowrap;
  }

  .order__list :global(.build__steps) {
    counter-reset: build-step;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0 0;
    padding: 0;
  }

  .order__list :global(.build__step) {
    counter-increment: build-step;
    font-size: var(--text-micro);
    padding: 0.25em 0.7em;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
    background: color-mix(in srgb, var(--color-gold) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-gold) 38%, transparent);
  }

  .order__list :global(.build__step)::before {
    content: counter(build-step) ' · ';
    color: var(--color-gold);
    font-weight: 600;
  }

  .agenda {
    margin-block-start: clamp(2rem, 1.4rem + 2vw, 3rem);
    padding-block-start: clamp(1.2rem, 0.9rem + 1.2vw, 1.8rem);
    border-block-start: 2px solid var(--color-gold);
  }

  .agenda__title {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-ink);
  }

  .agenda__note {
    margin: 0.45rem 0 0;
    max-inline-size: 66ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .agenda__sessions {
    list-style: none;
    display: grid;
    gap: clamp(0.9rem, 0.7rem + 0.8vw, 1.3rem);
    margin: clamp(1.2rem, 0.9rem + 1.2vw, 1.8rem) 0 0;
    padding: 0;
  }

  .agenda :global(.agenda__session) {
    padding: clamp(1rem, 0.8rem + 0.9vw, 1.4rem);
    background: #fff;
    border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
    border-inline-start: 3px solid var(--color-gold);
  }

  .agenda :global(.agenda__head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    padding-block-end: 0.7rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .agenda :global(.agenda__session-title) {
    margin: 0;
    font-size: var(--text-lede);
    color: var(--color-ink);
  }

  .agenda :global(.agenda__duration) {
