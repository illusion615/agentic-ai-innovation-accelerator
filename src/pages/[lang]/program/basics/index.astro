---
/**
 * BACKGROUND READING — a curated shelf, not an encyclopedia.
 *
 * The programme's own surfaces answer "what do I do"; this one answers "what do
 * I need to understand first", and it answers it by *pointing*. Every article
 * here is published in the Knowledge Hub and maintained there, once. Restating
 * any of it in this repo would fork the same material into two places and
 * guarantee the copies drift.
 *
 * The grouping is the design. A topic-ordered reading list is a syllabus and
 * nobody reads a syllabus; these are grouped by the moment in the programme
 * each becomes useful — before the twelve questions, before your hands are on
 * the tool, and the set you forward to whoever owns provisioning.
 */
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import SectionHead from '../../../../components/SectionHead.astro';
import { LANGS, isLang, localePath, type Lang } from '../../../../i18n/config';
import { useTranslations } from '../../../../i18n/content';
import { HUB_HOME, hubArticleUrl } from '../../../../lib/knowledge';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang: raw } = Astro.params;
const lang: Lang = isLang(raw) ? raw : 'en';
const t = useTranslations(lang);
const b = t.basics;

const GROUPS = ['start', 'build', 'it'] as const;

const shelf = (await getCollection('knowledge')).sort((x, y) => x.data.order - y.data.order);
---

<Base lang={lang} path="/program/basics/" axis={false} title={b.title}>
  <section id="basics" class="section basics">
    <div class="shell">
      <SectionHead as="h1" eyebrow={b.eyebrow} title={b.title} lede={b.lede} measure="wide" />

      <p class="basics__hub">
        <span class="meta-label basics__hub-label">{b.hubLabel}</span>
        <span class="basics__hub-note">{b.hubNote}</span>
      </p>

      {
        GROUPS.map((group) => {
          const items = shelf.filter((item) => item.data.group === group);
          if (!items.length) return null;
          return (
            <section class="shelf">
              <h2 class="shelf__title display">{b.groups[group].label}</h2>
              <p class="shelf__note">{b.groups[group].note}</p>

              <ul class="shelf__list">
                {items.map((item) => {
                  const copy = item.data[lang];
                  return (
                    <li class="read">
                      <a
                        class="read__link"
                        href={hubArticleUrl(item.data.slug)}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        <h3 class="read__title">{copy.title}</h3>
                        <span class="read__cta">
                          {b.openLabel}
                          <span aria-hidden="true"> ↗</span>
                        </span>
                      </a>
                      <p class="read__why">{copy.why}</p>
                    </li>
                  );
                })}
              </ul>
            </section>
          );
        })
      }

      <div class="basics__foot">
        <a class="btn btn--quiet" href={HUB_HOME} target="_blank" rel="noopener noreferrer">
          {b.hubCta}
        </a>
        <a class="btn btn--gold" href={localePath(lang, '/program/project/')}>{b.backLabel}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .basics__hub {
    display: grid;
    gap: 0.45rem;
    margin: clamp(1.75rem, 1.2rem + 2vw, 2.75rem) 0 0;
    padding-inline-start: 1rem;
    border-inline-start: 3px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
    max-inline-size: 62ch;
  }

  .basics__hub-label {
    color: var(--color-gold);
  }

  .basics__hub-note {
    font-size: var(--text-small);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }

  .shelf {
    margin-block-start: clamp(2.25rem, 1.5rem + 2.6vw, 3.5rem);
    max-inline-size: 62rem;
  }

  .shelf__title {
    margin: 0;
    font-size: var(--text-h3);
    color: var(--color-ink);
  }

  .shelf__note {
    margin: 0.5rem 0 0;
    max-inline-size: 58ch;
    font-size: var(--text-small);
    line-height: 1.6;
    color: var(--color-muted);
  }

  .shelf__list {
    list-style: none;
    margin: clamp(1rem, 0.8rem + 1vw, 1.6rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(0.9rem, 0.7rem + 0.8vw, 1.3rem);
  }

  .read {
    padding-block-start: clamp(0.9rem, 0.7rem + 0.6vw, 1.2rem);
    border-block-start: 1px solid color-mix(in srgb, var(--color-ink) 14%, transparent);
  }

  .read__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    text-decoration: none;
    color: inherit;
  }

  .read__title {
    /* Wraps inside its own column rather than pushing the CTA to a new line,
       which the longer hub titles otherwise do. */
    flex: 1 1 18ch;
    min-inline-size: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lede);
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .read__link:hover .read__title {
    color: var(--color-gold);
  }

  .read__cta {
    flex: none;
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-block-end: 0.2rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-gold) 60%, transparent);
  }

  .read__link:hover .read__cta {
    color: var(--color-gold);
    border-block-end-color: var(--color-gold);
  }

  .read__why {
    margin: 0.4rem 0 0;
    max-inline-size: 62ch;
    font-size: var(--text-small);
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 76%, transparent);
    text-wrap: pretty;
  }

  .basics__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-block-start: clamp(2.5rem, 1.6rem + 3vw, 4rem);
    padding-block-start: clamp(1.2rem, 0.9rem + 1.2vw, 1.8rem);
    border-block-start: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
  }
</style>
